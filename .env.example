# Zendesk API credentials
# Subdomain only: for https://yourcompany.zendesk.com use "yourcompany"
ZENDESK_SUBDOMAIN=yourcompany
# Email of the agent/admin the API token belongs to
ZENDESK_EMAIL=agent@yourcompany.com
# API token from Admin Center > Apps and integrations > APIs > Zendesk API
ZENDESK_API_TOKEN=your-zendesk-api-token

# OpenAI
OPENAI_API_KEY=sk-...
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Infor VISUAL (SQL Server, read-only) — used by the RTM tracker for serial/part lookups
VISUAL_DB_HOST=
VISUAL_DB_PORT=1433
VISUAL_DB_USER=
VISUAL_DB_PASSWORD=
# Database name, defaults to VECA
VISUAL_DB_NAME=VECA
# Site id used to scope VISUAL queries
VISUAL_SITE_ID=

# Postgres for RTM tracking data (schema "rtm"). Leave unset to disable RTM routes.
RTM_DATABASE_URL=postgresql://user:pass@host:25060/db?sslmode=require

# Flask session secret (needed for flash messages) — set a random string in production
FLASK_SECRET_KEY=
