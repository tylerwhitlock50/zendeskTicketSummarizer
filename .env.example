# Zendesk API credentials
# Subdomain only: for https://yourcompany.zendesk.com use "yourcompany"
ZENDESK_SUBDOMAIN=yourcompany
# Email of the agent/admin the API token belongs to
ZENDESK_EMAIL=agent@yourcompany.com
# API token from Admin Center > Apps and integrations > APIs > Zendesk API
ZENDESK_API_TOKEN=your-zendesk-api-token

# OpenAI
OPENAI_API_KEY=sk-...
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Postgres for the scan portal (quick-action config + audit log, schema "portal").
# Leave unset to run the one-pager only. RTM_DATABASE_URL still works as a fallback name.
DATABASE_URL=postgresql://user:pass@host:25060/db?sslmode=require

# Absolute base URL of this app as reachable from a phone scanning the printed QR
# code, e.g. https://repairportal.yourcompany.com — no trailing slash.
# Leave unset in dev to use the request host.
PORTAL_BASE_URL=

# Base tag stamped on every ticket the portal touches (default: repair-portal)
PORTAL_TAG=repair-portal

# Flask session secret (needed for flash messages) — set a random string in production
FLASK_SECRET_KEY=
