# Zendesk API credentials
# Subdomain only: for https://yourcompany.zendesk.com use "yourcompany"
ZENDESK_SUBDOMAIN=yourcompany
# Email of the agent/admin the API token belongs to
ZENDESK_EMAIL=agent@yourcompany.com
# API token from Admin Center > Apps and integrations > APIs > Zendesk API
ZENDESK_API_TOKEN=your-zendesk-api-token

# OpenAI
OPENAI_API_KEY=sk-...
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Postgres for the scan portal (quick-action config + audit log, schema "portal").
# Leave unset to run the one-pager only. RTM_DATABASE_URL still works as a fallback name.
DATABASE_URL=postgresql://user:pass@host:25060/db?sslmode=require

# Absolute base URL of this app as reachable from a phone scanning the printed QR
# code, e.g. https://repairportal.yourcompany.com — no trailing slash.
# Leave unset in dev to use the request host.
PORTAL_BASE_URL=

# Base tag stamped on every ticket the portal touches (default: repair-portal)
PORTAL_TAG=repair-portal

# Flask session secret (needed for flash messages) — set a random string in production
FLASK_SECRET_KEY=

# Tag CS adds in Zendesk to put a ticket on the portal's Incoming list (default: repair_process)
INTAKE_TAG=repair_process

# Optional: id of a Zendesk drop-down custom field "RMA Stage". When set, each stage
# post also sets that field to the stage's option value (configure values in Settings).
ZENDESK_STAGE_FIELD_ID=

# Password for the Settings pages (stages, lists, people). Unset = open to anyone on the network.
ADMIN_PASSWORD=

# How long a tech's name + PIN sign-in lasts on a device, in hours (default: 12)
TECH_SESSION_HOURS=12

# Return-shipment tracking. "easypost" or "shippo" plus that service's API key.
# When set, the delivery-checker service emails the customer once a rifle is
# delivered. Leave unset to mark deliveries by hand on the ticket page.
TRACKING_PROVIDER=
EASYPOST_API_KEY=
SHIPPO_API_KEY=

# Customer intake form. With REPAIR_INTAKE_ENABLED on (1/true/yes/on), adding a
# ticket to the repair queue posts a public comment with a private link, and
# Zendesk emails it to the customer. Default: off.
REPAIR_INTAKE_ENABLED=
# Only tickets created in Zendesk on or after this date/time get a link, e.g.
# 2026-12-01 or 2026-12-01T08:00:00Z (no time zone = UTC). Unset = no cutoff.
# A value that can't be read sends no links at all.
REPAIR_INTAKE_GO_LIVE_AT=
# Public address of the form as the customer's phone reaches it, e.g.
# https://repairs.yourcompany.com (no trailing slash). Unset = no link is sent.
# PORTAL_BASE_URL is the shop-network address and is never used for this.
REPAIR_INTAKE_BASE_URL=
# Set to 1 ONLY on the internet-facing copy of the app (the host in
# REPAIR_INTAKE_BASE_URL). That copy then serves the customer form and nothing
# else; every staff page answers 404. See docker-compose.public.yml.
PORTAL_PUBLIC_ONLY=
# Optional: ids of Zendesk ticket fields (text fields) to fill from the
# customer's answers. Leave blank to skip a field.
ZENDESK_INTAKE_SERIAL_FIELD_ID=
ZENDESK_INTAKE_MODEL_FIELD_ID=
ZENDESK_INTAKE_CALIBER_FIELD_ID=
# Optional: hours after the link before one reminder is sent (e.g. 48). 0 = no reminder.
REPAIR_INTAKE_REMINDER_HOURS=0
